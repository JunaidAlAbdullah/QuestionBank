# Port the Express API listens on
PORT=5000

# MySQL connection
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=question_bank

# Set to "true" when connecting to a cloud MySQL host that requires SSL
# (e.g. Aiven). Leave as "false" for local MySQL.
DB_SSL=false

# Secret used to sign JWT auth tokens - use a long random string in production
JWT_SECRET=replace_this_with_a_long_random_string
JWT_EXPIRES_IN=7d

# The deployed frontend origin, used for CORS. Include the protocol, no trailing slash.
# Local dev example: http://localhost:8080
FRONTEND_URL=http://localhost:8080

# Max upload size in megabytes for question PDFs/images
MAX_FILE_SIZE_MB=10
